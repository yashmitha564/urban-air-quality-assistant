"use strict";

// Get page elements
const statusElement = document.getElementById("status");
const aqiElement = document.getElementById("aqi");
const questionElement = document.getElementById("question");
const answerElement = document.getElementById("answer");

// AQI classification
function getAQIMessage(aqi) {
  if (aqi <= 50) return "Good 🌱";
  if (aqi <= 100) return "Moderate 🌤️";
  if (aqi <= 150) return "Unhealthy for sensitive groups ⚠️";
  if (aqi <= 200) return "Unhealthy";
  if (aqi <= 300) return "Very Unhealthy";
  return "Hazardous";
}

// Fetch air quality
async function getAirQuality() {
  if (!statusElement || !aqiElement) return;

  if (!navigator.geolocation) {
    statusElement.textContent = "Location is not supported.";
    return;
  }

  statusElement.textContent = "Finding your location...";

  navigator.geolocation.getCurrentPosition(
    async (position) => {
      try {
        const { latitude, longitude } = position.coords;

        const url =
          `https://air-quality-api.open-meteo.com/v1/air-quality?latitude=${latitude}&longitude=${longitude}&current=us_aqi`;

        const controller = new AbortController();
        const timeout = setTimeout(
          () => controller.abort(), 10000
        );

        let response;

        try {
          response = await fetch(url, {
            signal: controller.signal
          });
        } finally {
          clearTimeout(timeout);
        }

        if (!response.ok) {
          throw new Error("API request failed");
        }

        const data = await response.json();
        const aqi = data?.current?.us_aqi;

        if (
          typeof aqi !== "number" ||
          !Number.isFinite(aqi) ||
          aqi < 0
        ) {
          throw new Error("Invalid AQI data");
        }

        aqiElement.textContent = aqi;
        statusElement.textContent =
          getAQIMessage(aqi) + " (US AQI)";

      } catch (error) {
        statusElement.textContent =
          error.name === "AbortError"
            ? "Request timed out. Try again."
            : "Unable to load air quality data.";
      }
    },
    (error) => {
      statusElement.textContent =
        error.code === 1
          ? "Location permission denied."
          : "Unable to get your location.";
    },
    { timeout: 10000, maximumAge: 300000 }
  );
}

// Air quality assistant
function askAssistant() {
  if (!questionElement || !answerElement) return;

  const question =
    questionElement.value.trim().toLowerCase();

  if (!question) {
    answerElement.textContent =
      "Please enter a question.";
    return;
  }

  if (question.includes("travel")) {
    answerElement.textContent =
      "Consider public transport, walking or cycling when practical to reduce emissions.";
  } else if (question.includes("indoor")) {
    answerElement.textContent =
      "Keep indoor spaces clean and ventilate when outdoor air quality is better.";
  } else if (question.includes("health")) {
    answerElement.textContent =
      "Check local air quality advisories and take appropriate precautions during poor air quality.";
  } else {
    answerElement.textContent =
      "Check your local AQI, reduce unnecessary emissions and follow official air quality advice.";
  }
}

